<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Jellyfin plugin: assembly name must match output dll placed in plugins/AniBridge/ -->
    <AssemblyName>AniBridge</AssemblyName>
    <RootNamespace>AniBridge</RootNamespace>
    <Version>0.2.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/*.html" />
    <PackageReference Include="AngleSharp" Version="1.8.2" />
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
